cc_binary {
    name: "android.hardware.ir-service.xiaomi",
    relative_install_path: "hw",
    init_rc: ["android.hardware.ir-service.xiaomi.rc"],
    vintf_fragments: ["android.hardware.ir-service.xiaomi.xml"],
    srcs: [
        "ConsumerIr.cpp",
        "SpiPattern.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.ir-V1-ndk",
    ],
    vendor: true,
}
